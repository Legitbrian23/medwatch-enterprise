{
  "name": "medwatch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./apps/api\" test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "seed": "pnpm --filter \"./apps/api\" seed",
    "seed:demo": "pnpm --filter \"./apps/api\" seed:demo",
    "verify-data": "pnpm --filter \"./apps/api\" verify-data"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
