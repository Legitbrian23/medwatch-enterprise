{
  "name": "@medwatch/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify-data": "tsx scripts/verify-data.ts",
    "test": "vitest --run",
    "lint": "eslint src scripts --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "9.0.1",
    "@fastify/env": "4.3.0",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.0.1",
    "@medwatch/shared": "workspace:*",
    "argon2": "0.41.1",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "fastify-type-provider-zod": "2.0.0",
    "google-auth-library": "9.15.1",
    "googleapis": "144.0.0",
    "mongodb": "6.8.1",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.12",
    "@vitest/coverage-v8": "2.0.5",
    "mongodb-memory-server": "10.0.0",
    "tsx": "4.17.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
